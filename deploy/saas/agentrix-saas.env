# Agentrix SaaS · saas-node's non-secret settings. deploy/saas/deploy.sh appends these after the
# keys it carries from the repo's .env, so on the VM these win. Comments sit on their own lines:
# systemd's EnvironmentFile keeps a trailing comment as part of the value.
#
# Where the node listens. Caddy forwards money., kilele.money. and pay.agentrix.website here.
SAAS_ADDR=127.0.0.1:18190
# The agent doors publish and check https origins (the four hosts), not localhost ones.
SAAS_PUBLIC_ORIGINS=1
# Which books the companies keep: the unit runs `agentrix-saas --books $SAAS_BOOKS`. era is
# Zavora ERA through SAAS_ERA_URL, SAAS_ERA_TENANTS_FILE and mcp-erp; fake is the seeded story.
# deploy.sh --books fake|era switches without a commit.
SAAS_BOOKS=era
# Spec v3's join: one (the money layer mounted in agentrix-node, with agentrix-models beside it:
# the join's decision) or two (agentrix-node on 8080 and agentrix-saas on 18190, split by host
# in Caddy). v2 keeps spec v2's four hosts (Caddyfile.v2). deploy.sh --shape switches without a
# commit. two is what runs until the money layer's hosts follow AGENTRIX_ORIGIN on main.
SAAS_SHAPE=two
# Spec v3's platform host: the judged build lives here and under it (ops., <site>-sample., pay.,
# books.). In shapes one and two deploy.sh derives the node's door and books hosts from it.
SAAS_PLATFORM_HOST=paypal.agentrix.website
# Data: SQLite stores, company keys (keys/<company>), flows, audit exports.
SAAS_DATA_DIR=/var/lib/agentrix-saas
# The AG Studio board, built on the VM from web/saas-board, and its wallet grid (AG Grid), which
# `npm run build` writes as assets/wallet-grid.js for the Wallet app in Agentrix OS.
SAAS_BOARD_DIST=/opt/agentrix-saas/board
SAAS_WALLET_GRID_JS=/opt/agentrix-saas/board/assets/wallet-grid.js
# Zavora ERA's API on loopback (compose project saas-era), and the tenants' logins the seed made.
SAAS_ERA_URL=http://127.0.0.1:18180
SAAS_ERA_TENANTS_FILE=/var/lib/agentrix-saas/era/tenants.json
# mcp-erp (built with --features zavora) and its manifest folder.
MCP_ERP_BIN=/usr/local/lib/mcp-erp/mcp-erp
MCP_ERP_DIR=/usr/local/lib/mcp-erp
RUST_LOG=info,tower_http=warn
# The money layer as agentrix-node's module (shape one): Kilele Bakery's saved PayPal wallet
# (Vault) for Agentrix's app, and the cash its Payables agent counts as available.
SAAS_KILELE_VAULT_ID=5an08729le1870910
SAAS_KILELE_CASH_USD=100
# The platform's switches agx-control had (deploy/env/node.env): Agentrix OS offers Freeze and the
# operator console enforces holds, because the paths they stop check them.
AGENTRIX_FREEZE_ENFORCED=1
AGENTRIX_HOLDS_ENFORCED=1
# The home page (agentrix-home): its WhatsApp contact and hours, as on agx-control, and the films
# deploy.sh ships from SAAS_FILMS_DIR on the Mac (hero, film, classy, tana, salon .mp4).
AGENTRIX_HOME_WHATSAPP=+254721490933
AGENTRIX_HOME_WHATSAPP_HOURS="6am to 11pm EAT"
AGENTRIX_HOME_FILM_DIR=/opt/agentrix-saas/film
# No SAAS_JUDGE here: the live node stays live (real models within the caps, durable stores,
# settlement and the A2A doors mounted, PayPal sandbox). Judge mode would put the money layer on
# scripted models and in-memory stores without settlement; Run the day gets its own isolated
# instance instead (the coordinator's call, 11 Nov).
# The proofs the /proofs page shows and fills (PROOFS.md and proofs/), copied by deploy.sh from
# the commit's specs/saas to a folder the node may write.
SAAS_PROOFS_DIR=/var/lib/agentrix-saas/proofs
# The 12-hour live run (the coordinator, 11 Nov): both companies together may spend up to $10 of
# models per UTC day (the gateway's fleet cap). Each company's own cap stays
# AGENTRIX_SITE_DAILY_CAP_USD from .env.
SAAS_DAILY_MODEL_CAP_USD=10
# The money layer's trusted token issuers (an optional JSON file; a missing one is fine).
SAAS_TRUSTED_ISSUERS_FILE=/var/lib/agentrix-saas/trusted-issuers.json
# The test customer agents (shape one, agentrix-test-agents.service): where they listen (Caddy
# sends test-agent-<slug>.<platform host> and test-agents.<platform host> here), their data and
# off switch (present = paused), and when they stop by themselves. Their clock starts at each
# (re)start, so deploy.sh turns TEST_AGENTS_END (UTC; Thu 12 Nov 12:00 EAT, about 24 hours from
# the run's first start at 09:04 UTC on the 11th) into TEST_AGENTS_HOURS left at every deploy.
# TEST_AGENTS_HOURS is used as is only when TEST_AGENTS_END is unset.
TEST_AGENTS_LISTEN=127.0.0.1:18195
TEST_AGENTS_DATA_DIR=/var/lib/agentrix-saas/test-agents
TEST_AGENTS_OFF_FILE=/var/lib/agentrix-saas/test-agents/off
TEST_AGENTS_END=2026-11-12T09:00:00Z
TEST_AGENTS_HOURS=24
