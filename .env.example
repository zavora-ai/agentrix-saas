# Agentrix SaaS (PayPal AI Hackathon entry). Copy to .env (git-ignored, mode 0600) and fill in.
# Never commit real keys. Every key here is NEW and used only by this entry, never the Vultr
# entry's, so each can be capped and revoked on its own. Setup steps: specs/saas/partners.md
# Comments sit on their own lines: systemd's EnvironmentFile does not strip trailing ones.

# --- Hosts: subdomains of agentrix.website, explicit A records to saas-node. ---
# Agentrix (company 1): WebAgents front, owner console, treasury board.
SAAS_HOST=money.agentrix.website
# Kilele Bakery (company 2): its own AI staff and console.
SAAS_KILELE_HOST=kilele.money.agentrix.website
# Agent door: A2A, AWP manifest, checkout, PayPal webhooks, published agent keys.
SAAS_AGENT_DOOR_HOST=pay.agentrix.website
# Zavora ERA demo instance: both companies' books and CRM.
SAAS_BOOKS_HOST=books.agentrix.website

# --- PayPal sandbox: Agentrix, the seller (its own app on its own sandbox business account). ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox business account's email.
PAYPAL_MERCHANT_EMAIL=
# Filled after the webhook to https://pay.agentrix.website/paypal/webhook is registered.
PAYPAL_WEBHOOK_ID=

# --- PayPal sandbox: Kilele Bakery, the buyer company (second app, second business account). ---
KILELE_PAYPAL_CLIENT_ID=
KILELE_PAYPAL_CLIENT_SECRET=
KILELE_PAYPAL_MERCHANT_EMAIL=

# --- PayPal sandbox people. Emails only: passwords stay in PayPal's dashboard. ---
PAYPAL_BUYER_EMAIL_1=
PAYPAL_BUYER_EMAIL_2=
# A referral partner who receives a payout.
PAYPAL_PARTNER_EMAIL=

# --- Model keys. Only agentrix-models reads these. ---
# Anthropic: a new key in its own Console workspace ("agentrix-saas") with a monthly limit.
ANTHROPIC_API_KEY=
# Vultr Serverless Inference: a new key for this entry.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# --- Model mix (gateway tiers; callers name a purpose and maybe a tier, never a model). ---
# Claude carries the tiers: Opus $4/$20, Sonnet $2/$10, Haiku $0.10/$0.50 per million in/out.
AGENTRIX_PROVIDER=anthropic
AGENTRIX_TIER_DEEP_ANTHROPIC=claude-sonnet-5-5
AGENTRIX_TIER_STANDARD_ANTHROPIC=claude-sonnet-5-5
AGENTRIX_TIER_FAST_ANTHROPIC=claude-haiku-5-5
# Vultr tiers: glm-5.3 $0.75/$3.00, qwen3.8-27b $0.15/$1.00, deepseek-v4.1-flash-1017 $0.15/$0.60.
AGENTRIX_TIER_DEEP_VULTR=glm-5.3
AGENTRIX_TIER_STANDARD_VULTR=qwen3.8-27b
AGENTRIX_TIER_FAST_VULTR=deepseek-v4.1-flash-1017
# The chat desks (gateway purpose `concierge`) run on Vultr whatever the provider says.
# Slice B adds purposes for extraction and negotiation (crates/agentrix-models/src/route.rs).
AGENTRIX_ROUTE_CONCIERGE=vultr:qwen3.8-27b
# Specialists, always on Vultr.
AGENTRIX_EMBED=vultr:qwen3-embedding-4b
AGENTRIX_RERANK=vultr:bge-reranker-v2-m3
AGENTRIX_SCREEN_VULTR=nemotron-3.5-content-safety
AGENTRIX_VECTOR_STORE=vultr
AGENTRIX_STT=vultr:whisper-large-v3-turbo
AGENTRIX_TTS=vultr:qwen3-tts-12hz-1.7b
AGENTRIX_IMAGE=vultr:qwen-image-2.1

# --- Cost discipline. ---
# live, record or replay. Tests and CI use replay (no key, no network); judge mode replays attacks.
AGENTRIX_MODELS_MODE=live
# Hard model-spend limit per company per UTC day, and for both companies together.
AGENTRIX_SITE_DAILY_CAP_USD=2
SAAS_DAILY_MODEL_CAP_USD=3

# --- Vultr cloud: the saas-node VM and the four A records above. ---
VULTR_API_KEY=

# --- Zavora ERA demo instance (books.agentrix.website). Generated locally, not vendor keys. ---
ERA_DATABASE_PASSWORD=
ERA_JWT_ACCESS_SECRET=
ERA_JWT_REFRESH_SECRET=

# --- AG Grid (sponsor partner): AG Studio trial licence; AG Grid Enterprise trial key if separate. ---
AG_STUDIO_LICENSE_KEY=
AG_GRID_LICENSE_KEY=

# --- HeyGen: the Chief's presenter video (Avatar IV). ---
HEYGEN_API_KEY=
